{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vs-archive.local/schemas/mention_proposals.v1.json",
  "title": "Mention proposals v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "artifact_created_at",
    "producer",
    "logical_content_sha256",
    "document_snapshot_file_sha256",
    "discovery_logical_sha256",
    "discovery_file_sha256",
    "identity_snapshot_file_sha256",
    "production_write_performed",
    "detectors",
    "mentions"
  ],
  "properties": {
    "schema_version": {"const": "mention-proposals-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "artifact_created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "producer": {"$ref": "https://vs-archive.local/schemas/producer.v1.json"},
    "logical_content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "document_snapshot_file_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "discovery_logical_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "discovery_file_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "identity_snapshot_file_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "production_write_performed": {"const": false},
    "detectors": {
      "type": "array",
      "items": {"$ref": "#/$defs/detector"}
    },
    "mentions": {
      "type": "array",
      "items": {"$ref": "#/$defs/mention"}
    }
  },
  "$defs": {
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "implementation", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "reproducibility": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_item_id",
        "evidence_source",
        "exact_mention",
        "start_offset",
        "end_offset",
        "evidence_snippet",
        "name_surface",
        "name_start_offset",
        "name_end_offset",
        "title_surface",
        "title_start_offset",
        "title_end_offset",
        "surface_kind",
        "detector_ids",
        "known_name_match_quality"
      ],
      "properties": {
        "archive_item_id": {"type": "integer"},
        "evidence_source": {"type": "string", "minLength": 1},
        "exact_mention": {"type": "string", "minLength": 1},
        "start_offset": {"type": "integer", "minimum": 0},
        "end_offset": {"type": "integer", "minimum": 0},
        "evidence_snippet": {"type": "string", "minLength": 1},
        "name_surface": {"type": "string", "minLength": 1},
        "name_start_offset": {"type": "integer", "minimum": 0},
        "name_end_offset": {"type": "integer", "minimum": 0},
        "title_surface": {"type": ["string", "null"], "minLength": 1},
        "title_start_offset": {"type": ["integer", "null"], "minimum": 0},
        "title_end_offset": {"type": ["integer", "null"], "minimum": 0},
        "surface_kind": {
          "enum": [
            "FULL_NAME",
            "PARTIAL_NAME",
            "TITLE_AND_NAME",
            "NICKNAME",
            "UNCERTAIN_PERSON_NAME",
            null
          ]
        },
        "detector_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "known_name_match_quality": {
          "enum": ["EXACT_BOUNDARY", "PREFIXED", null]
        }
      }
    }
  }
}
