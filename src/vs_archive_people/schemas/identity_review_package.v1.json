{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vs-archive.local/schemas/identity_review_package.v1.json",
  "title": "Identity review package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "resolution_report_logical_sha256",
    "resolution_report_file_sha256",
    "kind",
    "production_write_performed",
    "photo_person_created",
    "biography_fields_included",
    "review_rows",
    "auto_resolution_proposals",
    "artifact_created_at",
    "producer",
    "logical_content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "identity-review-package-v1"},
    "run_id": {"type": "string"},
    "artifact_created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "producer": {"$ref": "https://vs-archive.local/schemas/producer.v1.json"},
    "logical_content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "resolution_report_logical_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "resolution_report_file_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "kind": {"const": "IDENTITY_REVIEW_NOT_APPLY"},
    "production_write_performed": {"const": false},
    "photo_person_created": {"const": false},
    "biography_fields_included": {"const": false},
    "review_rows": {"type": "array", "items": {"$ref": "#/$defs/reviewRow"}},
    "auto_resolution_proposals": {
      "type": "array",
      "items": {"$ref": "#/$defs/autoRow"}
    }
  },
  "$defs": {
    "reviewRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mention_key",
        "archive_item_id",
        "exact_mention",
        "evidence_source",
        "source_text_sha256",
        "evidence_snippet",
        "start_offset",
        "end_offset",
        "occurrence_index",
        "mention_fingerprint",
        "classification",
        "review_reason",
        "review_status"
      ],
      "properties": {
        "mention_key": {"type": "string"},
        "archive_item_id": {"type": "integer"},
        "exact_mention": {"type": "string"},
        "evidence_source": {"type": "string", "minLength": 1},
        "source_text_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "evidence_snippet": {"type": "string", "minLength": 1},
        "start_offset": {"type": "integer", "minimum": 0},
        "end_offset": {"type": "integer", "minimum": 0},
        "occurrence_index": {"type": "integer", "minimum": 0},
        "mention_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "classification": {
          "enum": [
            "DETERMINISTIC_EXISTING_PERSON",
            "AMBIGUOUS",
            "NEW_PERSON_CANDIDATE",
            "NOT_A_PERSON"
          ]
        },
        "matched_person_ids": {"type": "array"},
        "matched_person_name": {"type": ["string", "null"]},
        "matched_via": {"enum": ["canonical_name", "person_alias", null]},
        "stable_keys": {"type": "array"},
        "confidence": {"type": ["integer", "null"]},
        "confidence_used_for_classification": {"const": false},
        "inferred_alias_proposal": {"type": "boolean"},
        "proposed_identity_action": {"enum": ["MERGE", "CANONICAL_NAME_CHANGE", null]},
        "local_candidate_overlap": {"type": "boolean"},
        "review_status": {"const": "PENDING"},
        "review_reason": {"type": "string"}
      }
    },
    "autoRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mention_key",
        "archive_item_id",
        "exact_mention",
        "evidence_source",
        "source_text_sha256",
        "evidence_snippet",
        "start_offset",
        "end_offset",
        "occurrence_index",
        "mention_fingerprint",
        "classification",
        "proposal_status"
      ],
      "properties": {
        "mention_key": {"type": "string"},
        "archive_item_id": {"type": "integer"},
        "exact_mention": {"type": "string"},
        "evidence_source": {"type": "string", "minLength": 1},
        "source_text_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "evidence_snippet": {"type": "string", "minLength": 1},
        "start_offset": {"type": "integer", "minimum": 0},
        "end_offset": {"type": "integer", "minimum": 0},
        "occurrence_index": {"type": "integer", "minimum": 0},
        "mention_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "classification": {"const": "DETERMINISTIC_EXISTING_PERSON"},
        "matched_person_ids": {"type": "array"},
        "matched_person_name": {"type": ["string", "null"]},
        "matched_via": {"enum": ["canonical_name", "person_alias", null]},
        "stable_keys": {"type": "array"},
        "confidence": {"type": ["integer", "null"]},
        "confidence_used_for_classification": {"const": false},
        "inferred_alias_proposal": {"type": "boolean"},
        "proposed_identity_action": {"enum": ["MERGE", "CANONICAL_NAME_CHANGE", null]},
        "local_candidate_overlap": {"type": "boolean"},
        "review_status": {"const": "PENDING"},
        "proposal_status": {"const": "PROPOSED_NOT_APPLIED"}
      }
    }
  }
}
