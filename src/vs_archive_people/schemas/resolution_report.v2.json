{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vs-archive.local/schemas/resolution_report.v2.json",
  "title": "Resolution report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "evidence_package_logical_sha256",
    "evidence_package_file_sha256",
    "identity_snapshot_file_sha256",
    "production_write_performed",
    "photo_person_created",
    "resolutions",
    "artifact_created_at",
    "producer",
    "logical_content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "resolution-report-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "artifact_created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "producer": {"$ref": "https://vs-archive.local/schemas/producer.v1.json"},
    "logical_content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "evidence_package_logical_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "evidence_package_file_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "identity_snapshot_file_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "production_write_performed": {"const": false},
    "photo_person_rows_ignored": {"type": "integer", "minimum": 0},
    "photo_person_created": {"const": false},
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mention_key",
          "mention_fingerprint",
          "archive_item_id",
          "evidence_source",
          "source_text_sha256",
          "exact_mention",
          "start_offset",
          "end_offset",
          "evidence_snippet",
          "occurrence_index",
          "name_surface",
          "name_start_offset",
          "name_end_offset",
          "title_surface",
          "title_start_offset",
          "title_end_offset",
          "surface_kind",
          "detector_ids",
          "known_name_match_quality",
          "classification",
          "matched_person_ids",
          "matched_person_name",
          "matched_via",
          "matched_alias_id",
          "stable_keys",
          "review_status",
          "identity_is_production"
        ],
        "properties": {
          "mention_key": {"type": "string", "pattern": "^M[0-9]{4,}$"},
          "mention_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "archive_item_id": {"type": "integer"},
          "evidence_source": {"type": "string", "minLength": 1},
          "source_text_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "exact_mention": {"type": "string", "minLength": 1},
          "start_offset": {"type": "integer", "minimum": 0},
          "end_offset": {"type": "integer", "minimum": 0},
          "evidence_snippet": {"type": "string", "minLength": 1},
          "occurrence_index": {"type": "integer", "minimum": 0},
          "name_surface": {"type": "string", "minLength": 1},
          "name_start_offset": {"type": "integer", "minimum": 0},
          "name_end_offset": {"type": "integer", "minimum": 0},
          "title_surface": {"type": ["string", "null"], "minLength": 1},
          "title_start_offset": {"type": ["integer", "null"], "minimum": 0},
          "title_end_offset": {"type": ["integer", "null"], "minimum": 0},
          "surface_kind": {
            "enum": [
              "FULL_NAME",
              "PARTIAL_NAME",
              "TITLE_AND_NAME",
              "NICKNAME",
              "UNCERTAIN_PERSON_NAME",
              null
            ]
          },
          "detector_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "known_name_match_quality": {
            "enum": ["EXACT_BOUNDARY", "PREFIXED", null]
          },
          "classification": {
            "enum": [
              "DETERMINISTIC_EXISTING_PERSON",
              "AMBIGUOUS",
              "NEW_PERSON_CANDIDATE"
            ]
          },
          "matched_person_ids": {"type": "array", "items": {"type": "integer"}},
          "matched_person_name": {"type": ["string", "null"]},
          "matched_via": {"enum": ["canonical_name", "person_alias", null]},
          "matched_alias_id": {"type": ["integer", "null"]},
          "stable_keys": {"type": "array", "items": {"type": "string"}},
          "review_status": {"const": "PENDING"},
          "identity_is_production": {"type": "boolean"}
        }
      }
    }
  }
}
